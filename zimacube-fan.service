[Unit]
Description=ZimaCube 2 disk-aware disk-cage fan controller
Documentation=https://github.com/cyanide-burnout/zimacube-bay
After=local-fs.target systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=/usr/bin/env modprobe zimacube_bay
ExecStart=/usr/local/sbin/zimacube-fan --interval 30 --active-speed 60 --idle-speed 40 --cooldown 120 --disk-temp --disk-temp-low 40 --disk-temp-high 55 --max-speed 100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
